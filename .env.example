# Database Configuration
DB_HOST=mysql
DB_USER=todo_app
DB_PASSWORD=your_secure_password
DB_NAME=todolist_db
MYSQL_ROOT_PASSWORD=your_root_password

# Server Configuration
PORT=3000

# CORS Configuration (comma-separated list of allowed origins)
# For local development:
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# For production with DuckDNS domain (replace with your actual domain):
# ALLOWED_ORIGINS=https://your-subdomain.duckdns.org,http://localhost:3000
# For production with IP address:
# ALLOWED_ORIGINS=http://159.223.130.149,http://localhost:3000
